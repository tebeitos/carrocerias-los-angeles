---
import { negocio } from '../data/negocio';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Carrocerías Los Ángeles - Chapista Gijón | Restauración de Clásicos Asturias`, 
  description = `Taller de carrocería en Gijón desde ${negocio.fundacion}. Especialistas en chapa batida a mano, reparación de vehículos industriales y restauración de clásicos en Asturias.` 
} = Astro.props;

// Asegurar que el canonical apunte al dominio oficial de producción, nunca a localhost
const canonicalUrl = `https://carroceriaslosangeles.com${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://carroceriaslosangeles.com/nave.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Yellowtail&display=swap" rel="stylesheet">

    <!-- Schema.org estructurado AutoBodyShop -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "AutoBodyShop",
        "name": "Carrocerías Los Ángeles",
        "image": "https://carroceriaslosangeles.com/nave.jpg",
        "description": "Taller de chapa y pintura tradicional en Gijón desde 1970. Especialistas en chapa batida a mano y restauración de vehículos clásicos.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Guillermo Marconi, 40 · Pol. Roces – Puente Seco",
          "addressLocality": "Gijón",
          "postalCode": "33211",
          "addressRegion": "Asturias",
          "addressCountry": "ES"
        },
        "telephone": "+34985167281",
        "priceRange": "$$",
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "08:30",
          "closes": "18:00"
        }
      }
    </script>
  </head>
  <body>
    <!-- Fajas industriales / Líneas de acento superiores -->
    <div class="top-industrial-bar"></div>

    <!-- Banner Decorativo Izquierdo (Móvil Oculto, Escritorio Visible) -->
    <aside class="vertical-sign sign-left" aria-hidden="true">
      <span class="star">★</span>
      <span class="vertical-text">CHAPA</span>
      <span class="star">★</span>
    </aside>

    <!-- Banner Decorativo Derecho (Móvil Oculto, Escritorio Visible) -->
    <aside class="vertical-sign sign-right" aria-hidden="true">
      <span class="star">★</span>
      <span class="vertical-text">PINTURA</span>
      <span class="star">★</span>
    </aside>

    <div class="page-wrapper">
      <!-- Encabezado Principal -->
      <header class="main-header">
        <div class="header-inner">
          
          <!-- Bloque del Logotipo Réplica Rótulo Real -->
          <a href="/" class="logo-link" title="Inicio - Carrocerías Los Ángeles">
            <div class="logo-block">
              <div class="logo-top-row">
                <!-- Icono camión izquierdo -->
                <svg class="truck-icon" viewBox="0 0 64 24" fill="currentColor">
                  <path d="M2,18 L6,18 L6,14 L12,14 L16,8 L36,8 L36,18 L52,18 L52,12 L58,12 L62,16 L62,18 L60,18 C60,20 58,22 56,22 C54,22 52,20 52,18 L24,18 C24,20 22,22 20,22 C18,22 16,20 16,18 L8,18 C8,20 6,22 4,22 C2,22 0,20 0,18 Z M4,20 C5.1,20 6,19.1 6,18 C6,16.9 5.1,16 4,16 C2.9,16 2,16.9 2,18 C2,19.1 2.9,20 4,20 Z M20,20 C21.1,20 22,19.1 22,18 C22,16.9 21.1,16 20,16 C18.9,16 18,16.9 18,18 C18,19.1 18.9,20 20,20 Z M56,20 C57.1,20 58,19.1 58,18 C58,16.9 57.1,16 56,16 C54.9,16 54,16.9 54,18 C54,19.1 54.9,20 56,20 Z" />
                </svg>
                
                <div class="banner-divided">
                  <span class="banner-text">Carrocerías</span>
                </div>

                <!-- Icono camión derecho -->
                <svg class="truck-icon flip-h" viewBox="0 0 64 24" fill="currentColor">
                  <path d="M2,18 L6,18 L6,14 L12,14 L16,8 L36,8 L36,18 L52,18 L52,12 L58,12 L62,16 L62,18 L60,18 C60,20 58,22 56,22 C54,22 52,20 52,18 L24,18 C24,20 22,22 20,22 C18,22 16,20 16,18 L8,18 C8,20 6,22 4,22 C2,22 0,20 0,18 Z M4,20 C5.1,20 6,19.1 6,18 C6,16.9 5.1,16 4,16 C2.9,16 2,16.9 2,18 C2,19.1 2.9,20 4,20 Z M20,20 C21.1,20 22,19.1 22,18 C22,16.9 21.1,16 20,16 C18.9,16 18,16.9 18,18 C18,19.1 18.9,20 20,20 Z M56,20 C57.1,20 58,19.1 58,18 C58,16.9 57.1,16 56,16 C54.9,16 54,16.9 54,18 C54,19.1 54.9,20 56,20 Z" />
                </svg>
              </div>
              <div class="logo-bottom-row">
                <!-- Icono coche izquierdo -->
                <svg class="car-icon" viewBox="0 0 54 20" fill="currentColor">
                  <path d="M2,14 L6,14 L8,10 L18,10 L22,6 L42,6 L46,10 L50,10 L52,14 C53,14 54,15 54,16 L54,17 L50,17 C50,18.7 48.7,20 47,20 C45.3,20 44,18.7 44,17 L14,17 C14,18.7 12.7,20 11,20 C9.3,20 8,18.7 8,17 L0,17 L0,16 C0,15 1,14 2,14 Z M11,18 C11.6,18 12,17.6 12,17 C12,16.4 11.6,16 11,16 C10.4,16 10,16.4 10,17 C10,17.6 10.4,18 11,18 Z M47,18 C47.6,18 48,17.6 48,17 C48,16.4 48.6,16 47,16 C46.4,16 46,16.4 46,17 C46,17.6 46.4,18 47,18 Z" />
                </svg>
                
                <span class="logo-main-title">LOS ANGELES</span>

                <!-- Icono coche derecho -->
                <svg class="car-icon flip-h" viewBox="0 0 54 20" fill="currentColor">
                  <path d="M2,14 L6,14 L8,10 L18,10 L22,6 L42,6 L46,10 L50,10 L52,14 C53,14 54,15 54,16 L54,17 L50,17 C50,18.7 48.7,20 47,20 C45.3,20 44,18.7 44,17 L14,17 C14,18.7 12.7,20 11,20 C9.3,20 8,18.7 8,17 L0,17 L0,16 C0,15 1,14 2,14 Z M11,18 C11.6,18 12,17.6 12,17 C12,16.4 11.6,16 11,16 C10.4,16 10,16.4 10,17 C10,17.6 10.4,18 11,18 Z M47,18 C47.6,18 48,17.6 48,17 C48,16.4 48.6,16 47,16 C46.4,16 46,16.4 46,17 C46,17.6 46.4,18 47,18 Z" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Subtítulo de Solera del Taller -->
          <p class="tagline">{negocio.eslogan}</p>

          <!-- Navegación Industrial -->
          <nav class="industrial-nav">
            <ul>
              <li><a href="/" class="nav-item">INICIO</a></li>
              <li><a href="/#oficio" class="nav-item">EL OFICIO</a></li>
              <li><a href="/#comparativa" class="nav-item">BATIR VS SOLDAR</a></li>
              <li><a href="/#clasicos" class="nav-item">RESTAURACIÓN</a></li>
              <li><a href="/#trabajos" class="nav-item">TRABAJOS</a></li>
              <li><a href="/#opiniones" class="nav-item">OPINIONES</a></li>
              <li><a href="/#contacto" class="nav-item">CONTACTO</a></li>
            </ul>
          </nav>
        </div>
      </header>

      <!-- Contenedor del Contenido Principal -->
      <main class="main-content">
        <slot />
      </main>

      <!-- Pie de Página Industrial -->
      <footer class="main-footer">
        <div class="footer-inner">
          <div class="footer-grid">
            <!-- Columna 1: Contacto -->
            <div class="footer-col">
              <span class="footer-title">CONTACTO</span>
              <div class="contact-details">
                <p class="phone-block">
                  <span class="label">Teléfono:</span>
                  <a href={`tel:${negocio.telefonoLink}`} class="phone-link">{negocio.telefono}</a>
                </p>
                <p>
                  <span class="label">Email:</span> 
                  <a href={`mailto:${negocio.email}`} class="email-link">{negocio.email}</a>
                </p>
              </div>
            </div>

            <!-- Columna 2: Ubicación física -->
            <div class="footer-col">
              <span class="footer-title">UBICACIÓN</span>
              <address class="address-block">
                <p>{negocio.direccion}</p>
                <p>{negocio.cp} · {negocio.ciudad}, Asturias</p>
              </address>
            </div>

            <!-- Columna 3: Enlaces de interés legal -->
            <div class="footer-col">
              <span class="footer-title">DOCUMENTACIÓN</span>
              <ul class="legal-links-list">
                <li><a href="/aviso-legal">Aviso Legal</a></li>
                <li><a href="/privacidad">Política de Privacidad</a></li>
              </ul>
              <p class="since-block">Tradición metálica en Gijón desde {negocio.fundacion}.</p>
            </div>
          </div>

          <div class="footer-bottom">
            <p>&copy; {new Date().getFullYear()} {negocio.nombre}. Todos los derechos reservados.</p>
            <p class="tag-engineering">GIJÓN · PRINCIPADO DE ASTURIAS</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* --- SISTEMA DE DISEÑO INDUSTRIAL --- */
  :root {
    --color-red: #D6221F;
    --color-black: #1A1A1A;
    --color-bg: #F7F4EF;
    --color-yellow: #F2C300;
    --font-title: 'Anton', sans-serif;
    --font-body: 'Work Sans', sans-serif;
    --font-logo: 'Yellowtail', cursive;
    
    --border-width: 3px;
  }

  /* Reset Industrial */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--color-bg);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* --- TIPOGRAFÍA GENERAL --- */
  h1, h2, h3, h4, h5, h6, .logo-main-title, .footer-title {
    font-family: var(--font-title);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.1;
    color: var(--color-black);
    font-weight: normal;
  }

  p {
    margin-bottom: 1.2rem;
    font-weight: 400;
  }

  a {
    color: var(--color-red);
    text-decoration: none;
    transition: color 0.1s steps(2);
  }

  a:hover {
    color: var(--color-black);
  }

  /* --- FAJAS INDUSTRIALES Y ROTULACIÓN --- */
  .top-industrial-bar {
    height: 12px;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-yellow),
      var(--color-yellow) 15px,
      var(--color-black) 15px,
      var(--color-black) 30px
    );
    border-bottom: var(--border-width) solid var(--color-black);
    width: 100%;
  }

  /* Rótulos Verticales a los lados del taller ("CHAPA" y "PINTURA") */
  .vertical-sign {
    display: none;
  }

  @media (min-width: 1200px) {
    .vertical-sign {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      background-color: var(--color-black);
      color: var(--color-yellow);
      border: var(--border-width) solid var(--color-red);
      padding: 25px 8px;
      z-index: 100;
      box-shadow: none;
      width: 54px;
    }

    .sign-left {
      left: 15px;
    }

    .sign-right {
      right: 15px;
    }

    .vertical-text {
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-family: var(--font-title);
      font-size: 1.6rem;
      letter-spacing: 0.15em;
      margin: 15px 0;
      line-height: 1;
    }

    .star {
      font-size: 1.1rem;
      color: var(--color-yellow);
    }
  }

  /* --- ESTRUCTURA GENERAL DE LA PÁGINA --- */
  .page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 1200px) {
    .page-wrapper {
      padding: 0;
    }
  }

  /* --- HEADER & REPLICACIÓN RÓTULO REAL --- */
  .main-header {
    padding: 30px 0 20px 0;
    text-align: center;
    border-bottom: var(--border-width) solid var(--color-black);
    background-color: var(--color-bg);
  }

  .logo-link {
    display: inline-block;
    color: inherit;
    margin-bottom: 12px;
  }

  .logo-link:hover {
    color: inherit;
  }

  .logo-block {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
  }

  /* Fila superior: Camión - Caja dividida - Camión */
  .logo-top-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 5px;
    width: 100%;
  }

  .banner-divided {
    display: inline-flex;
    position: relative;
    height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 45px;
    background: linear-gradient(to right, var(--color-black) 50%, var(--color-red) 50%);
    border: var(--border-width) solid var(--color-black);
  }

  .banner-text {
    font-family: var(--font-logo);
    color: #FFFFFF;
    font-size: 2.1rem;
    font-weight: normal;
    line-height: 1;
    z-index: 2;
    transform: skewX(-6deg);
    display: inline-block;
  }

  .truck-icon {
    width: 55px;
    height: 22px;
    color: var(--color-black);
    flex-shrink: 0;
  }

  /* Fila inferior: Coche - LOS ANGELES - Coche */
  .logo-bottom-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: 100%;
  }

  .logo-main-title {
    font-family: var(--font-title);
    color: var(--color-red);
    font-size: 3.2rem;
    line-height: 0.95;
    letter-spacing: 0.04em;
    -webkit-text-stroke: 1.5px var(--color-black);
    text-shadow: 2.5px 2.5px 0px var(--color-black);
  }

  .car-icon {
    width: 48px;
    height: 18px;
    color: var(--color-black);
    flex-shrink: 0;
  }

  /* Utilidades para iconos */
  .flip-h {
    transform: scaleX(-1);
  }

  @media (max-width: 600px) {
    .logo-top-row {
      gap: 5px;
    }
    .banner-divided {
      height: 38px;
      padding: 0 25px;
    }
    .banner-text {
      font-size: 1.6rem;
    }
    .truck-icon {
      width: 35px;
      height: 14px;
    }
    .logo-bottom-row {
      gap: 5px;
    }
    .logo-main-title {
      font-size: 2.2rem;
      -webkit-text-stroke: 1px var(--color-black);
      text-shadow: 1.5px 1.5px 0px var(--color-black);
    }
    .car-icon {
      width: 30px;
      height: 12px;
    }
  }

  /* Lema o Eslogan */
  .tagline {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-black);
    margin: 10px 0 20px 0;
    font-style: italic;
  }

  /* --- MENU DE NAVEGACION INDUSTRIAL --- */
  .industrial-nav {
    display: inline-block;
    width: 100%;
    margin-top: 10px;
  }

  .industrial-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    border: var(--border-width) solid var(--color-black);
    background-color: var(--color-bg);
  }

  .industrial-nav li {
    border-right: var(--border-width) solid var(--color-black);
  }

  .industrial-nav li:last-child {
    border-right: none;
  }

  .nav-item {
    display: block;
    padding: 10px 24px;
    font-family: var(--font-title);
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    color: var(--color-black);
    background-color: transparent;
    transition: background-color 0.1s steps(2), color 0.1s steps(2);
  }

  .nav-item:hover {
    background-color: var(--color-black);
    color: var(--color-yellow);
  }

  @media (max-width: 800px) {
    .industrial-nav ul {
      border: var(--border-width) solid var(--color-black);
    }
    .nav-item {
      padding: 10px 14px;
      font-size: 1rem;
    }
  }

  @media (max-width: 600px) {
    .industrial-nav ul {
      flex-direction: column;
    }
    .industrial-nav li {
      border-right: none;
      border-bottom: var(--border-width) solid var(--color-black);
    }
    .industrial-nav li:last-child {
      border-bottom: none;
    }
    .nav-item {
      padding: 12px;
    }
  }

  /* --- CONTENIDO PRINCIPAL --- */
  .main-content {
    flex-grow: 1;
    padding: 40px 0;
  }

  /* --- FOOTER PESADO E INDUSTRIAL --- */
  .main-footer {
    background-color: var(--color-black);
    color: var(--color-bg);
    border-top: var(--border-width) solid var(--color-red);
    padding: 45px 0 25px 0;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    padding-bottom: 35px;
    border-bottom: 2px solid rgba(247, 244, 239, 0.15);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    color: var(--color-yellow);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--color-red);
    padding-bottom: 5px;
    align-self: flex-start;
  }

  .contact-details p {
    margin-bottom: 12px;
  }

  .contact-details .label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
  }

  .phone-link {
    font-family: var(--font-title);
    font-size: 1.8rem;
    color: var(--color-red);
    letter-spacing: 0.02em;
    line-height: 1.2;
    display: inline-block;
  }

  .phone-link:hover {
    color: var(--color-yellow);
  }

  .email-link {
    color: var(--color-bg);
    text-decoration: underline;
    font-weight: 500;
  }

  .email-link:hover {
    color: var(--color-red);
  }

  .address-block {
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .since-block {
    font-weight: bold;
    color: var(--color-red);
    margin-bottom: 10px;
    margin-top: 15px;
  }

  .legal-links-list {
    list-style: none;
    margin-bottom: 15px;
  }

  .legal-links-list li {
    margin-bottom: 8px;
  }

  .legal-links-list a {
    color: #CCCCCC;
    text-decoration: underline;
    font-size: 0.95rem;
  }

  .legal-links-list a:hover {
    color: var(--color-yellow);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 20px;
    font-size: 0.8rem;
    color: #888888;
    gap: 10px;
  }

  .tag-engineering {
    font-family: var(--font-title);
    color: var(--color-bg);
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Estilos de Botones / Componentes comunes de utilidad industrial */
  .btn-industrial {
    display: inline-block;
    background-color: var(--color-red);
    color: white;
    font-family: var(--font-title);
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    padding: 12px 30px;
    border: var(--border-width) solid var(--color-black);
    text-align: center;
    cursor: pointer;
    transition: background-color 0.1s steps(2), color 0.1s steps(2);
  }

  .btn-industrial:hover {
    background-color: var(--color-black);
    color: var(--color-yellow);
  }
</style>
