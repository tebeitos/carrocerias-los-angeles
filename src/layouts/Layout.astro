---
import { negocio } from '../data/negocio';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Carrocerías Los Ángeles - Chapista Gijón | Restauración de Clásicos Asturias`, 
  description = `Taller de carrocería en Gijón desde ${negocio.fundacion}. Especialistas en chapa batida a mano, reparación de vehículos industriales y restauración de clásicos en Asturias.` 
} = Astro.props;

// Asegurar que el canonical apunte al dominio oficial de producción, nunca a localhost
const canonicalUrl = `https://carroceriaslosangeles.com${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://carroceriaslosangeles.com/nave.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Yellowtail&display=swap" rel="stylesheet">

    <!-- Schema.org estructurado AutoBodyShop -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "AutoBodyShop",
        "name": "Carrocerías Los Ángeles",
        "image": "https://carroceriaslosangeles.com/nave.png",
        "description": "Taller de chapa y pintura tradicional en Gijón desde 1970. Especialistas en chapa batida a mano y restauración de vehículos clásicos.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Guillermo Marconi, 40 · Pol. Roces – Puente Seco",
          "addressLocality": "Gijón",
          "postalCode": "33211",
          "addressRegion": "Asturias",
          "addressCountry": "ES"
        },
        "telephone": "+34985167281",
        "priceRange": "$$",
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "08:30",
          "closes": "18:00"
        }
      }
    </script>
  </head>
  <body>
    <!-- Fajas industriales / Líneas de acento superiores -->
    <div class="top-industrial-bar"></div>

    <div class="page-wrapper">
      <!-- Encabezado Principal -->
      <header class="main-header">
        
        <!-- Barra de Cabecera Móvil (Visible solo en móvil) -->
        <div class="mobile-header-bar">
          <!-- Botón menú desplegable a la izquierda -->
          <button id="menu-toggle" class="menu-toggle-btn" aria-label="Abrir menú de navegación" aria-controls="mobile-nav">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </button>
          
          <!-- Logotipo réplica rótulo real recuperado en móvil -->
          <a href="/" class="mobile-logo-link" title="Inicio - Carrocerías Los Ángeles">
            <div class="logo-block">
              <div class="logo-top-row">
                <div class="banner-divided">
                  <span class="banner-text">Carrocerías</span>
                </div>
              </div>
              <div class="logo-bottom-row">
                <span class="logo-main-title">LOS ANGELES</span>
              </div>
            </div>
          </a>
          
          <!-- Botón de llamar a la derecha para equilibrar visualmente -->
          <a href={`tel:${negocio.telefonoLink}`} class="mobile-call-btn" title="Llamar al taller" aria-label="Llamar al taller">
            <svg viewBox="0 0 24 24" class="phone-svg" fill="currentColor">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
          </a>
        </div>

        <!-- Cabecera de Escritorio (Oculta en móvil) -->
        <div class="desktop-header-only">
          <div class="header-inner">
            <!-- Bloque del Logotipo Réplica Rótulo Real (Pulido sin iconos externos) -->
            <a href="/" class="logo-link" title="Inicio - Carrocerías Los Ángeles">
              <div class="logo-block">
                <div class="logo-top-row">
                  <div class="banner-divided">
                    <span class="banner-text">Carrocerías</span>
                  </div>
                </div>
                <div class="logo-bottom-row">
                  <span class="logo-main-title">LOS ANGELES</span>
                </div>
              </div>
            </a>

            <!-- Subtítulo de Solera del Taller -->
            <p class="tagline">{negocio.eslogan}</p>
          </div>
        </div>

        <!-- Menú Desplegable de Navegación Móvil (Despliega desde la izquierda) -->
        <nav id="mobile-nav" class="mobile-nav-menu" aria-expanded="false">
          <ul>
            <li><a href="/#oficio" class="mobile-nav-item">EL OFICIO</a></li>
            <li><a href="/#comparativa" class="mobile-nav-item">BATIR VS SOLDAR</a></li>
            <li><a href="/#instalaciones" class="mobile-nav-item">EL TALLER</a></li>
            <li><a href="/#clasicos" class="mobile-nav-item">RESTAURACIÓN</a></li>
            <li><a href="/#trabajos" class="mobile-nav-item">TRABAJOS</a></li>
            <li><a href="/#opiniones" class="mobile-nav-item">OPINIONES</a></li>
            <li><a href="/#contacto" class="mobile-nav-item">CONTACTO</a></li>
          </ul>
        </nav>

        <!-- Navegación Industrial Desktop -->
        <nav class="industrial-nav desktop-nav-only">
          <ul>
            <li><a href="/#oficio" class="nav-item">EL OFICIO</a></li>
            <li><a href="/#comparativa" class="nav-item">BATIR VS SOLDAR</a></li>
            <li><a href="/#instalaciones" class="nav-item">EL TALLER</a></li>
            <li><a href="/#clasicos" class="nav-item">RESTAURACIÓN</a></li>
            <li><a href="/#trabajos" class="nav-item">TRABAJOS</a></li>
            <li><a href="/#opiniones" class="nav-item">OPINIONES</a></li>
            <li><a href="/#contacto" class="nav-item">CONTACTO</a></li>
          </ul>
        </nav>
      </header>

      <!-- Contenedor del Contenido Principal -->
      <main class="main-content">
        <slot />
      </main>
    </div>

    <!-- Pie de Página Industrial (100% ancho, contenido centrado con padding) -->
    <footer class="main-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <!-- Columna 1: Contacto -->
          <div class="footer-col">
            <span class="footer-title">CONTACTO</span>
            <div class="contact-details">
              <p class="phone-block">
                <span class="label">Teléfono:</span>
                <a href={`tel:${negocio.telefonoLink}`} class="phone-link">{negocio.telefono}</a>
              </p>
              <p>
                <span class="label">Email:</span> 
                <a href={`mailto:${negocio.email}`} class="email-link">{negocio.email}</a>
              </p>
            </div>
          </div>

          <!-- Columna 2: Ubicación física -->
          <div class="footer-col">
            <span class="footer-title">UBICACIÓN</span>
            <address class="address-block">
              <p>{negocio.direccion}</p>
              <p>{negocio.cp} · {negocio.ciudad}, Asturias</p>
            </address>
          </div>

          <!-- Columna 3: Enlaces de interés legal -->
          <div class="footer-col">
            <span class="footer-title">DOCUMENTACIÓN</span>
            <ul class="legal-links-list">
              <li><a href="/aviso-legal">Aviso Legal</a></li>
              <li><a href="/privacidad">Política de Privacidad</a></li>
            </ul>
            <p class="since-block">Tradición metálica en Gijón desde {negocio.fundacion}.</p>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} {negocio.nombre}. Todos los derechos reservados.</p>
          <p class="tag-engineering">GIJÓN · PRINCIPADO DE ASTURIAS</p>
        </div>
      </div>
    </footer>

    <!-- Script Inline para controlar el menú desplegable móvil -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('menu-toggle');
        const mobileNav = document.getElementById('mobile-nav');

        if (toggleBtn && mobileNav) {
          toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = mobileNav.classList.toggle('active');
            toggleBtn.classList.toggle('active');
            mobileNav.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          // Cerrar el menú al hacer clic en un enlace
          mobileNav.querySelectorAll('.mobile-nav-item').forEach(item => {
            item.addEventListener('click', () => {
              mobileNav.classList.remove('active');
              toggleBtn.classList.remove('active');
              mobileNav.setAttribute('aria-expanded', 'false');
            });
          });

          // Cerrar al hacer clic fuera del menú
          document.addEventListener('click', (e) => {
            if (!mobileNav.contains(e.target) && !toggleBtn.contains(e.target)) {
              mobileNav.classList.remove('active');
              toggleBtn.classList.remove('active');
              mobileNav.setAttribute('aria-expanded', 'false');
            }
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* --- SISTEMA DE DISEÑO INDUSTRIAL --- */
  :root {
    --color-red: #D6221F;
    --color-black: #1A1A1A;
    --color-bg: #F7F4EF;
    --color-yellow: #F2C300;
    --font-title: 'Anton', sans-serif;
    --font-body: 'Work Sans', sans-serif;
    --font-logo: 'Yellowtail', cursive;
    
    --border-width: 3px;
  }

  /* Reset Industrial */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--color-bg);
    color: var(--color-black);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* --- TIPOGRAFÍA GENERAL --- */
  h1, h2, h3, h4, h5, h6, .logo-main-title, .footer-title {
    font-family: var(--font-title);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.1;
    color: var(--color-black);
    font-weight: normal;
  }

  p {
    margin-bottom: 1.2rem;
    font-weight: 400;
  }

  a {
    color: var(--color-red);
    text-decoration: none;
    transition: color 0.1s steps(2);
  }

  a:hover {
    color: var(--color-black);
  }

  /* --- FAJAS INDUSTRIALES Y ROTULACIÓN --- */
  .top-industrial-bar {
    height: 12px;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-yellow),
      var(--color-yellow) 15px,
      var(--color-black) 15px,
      var(--color-black) 30px
    );
    border-bottom: var(--border-width) solid var(--color-black);
    width: 100%;
  }

  /* --- ESTRUCTURA GENERAL DE LA PÁGINA --- */
  .page-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 1200px) {
    .page-wrapper {
      padding: 0;
    }
  }

  /* --- CABECERA DE ESCRITORIO --- */
  .main-header {
    padding: 30px 0 20px 0;
    border-bottom: var(--border-width) solid var(--color-black);
    background-color: var(--color-bg);
    text-align: center;
  }

  .logo-link {
    display: inline-block;
    color: inherit;
    margin-bottom: 12px;
  }

  .logo-link:hover {
    color: inherit;
  }

  .logo-block {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
  }

  /* Fila superior: Caja dividida */
  .logo-top-row {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    width: 100%;
  }

  .banner-divided {
    display: inline-flex;
    position: relative;
    height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 55px;
    background: linear-gradient(to right, var(--color-black) 50%, var(--color-red) 50%);
    border: var(--border-width) solid var(--color-black);
  }

  .banner-text {
    font-family: var(--font-logo);
    color: #FFFFFF;
    font-size: 2.3rem;
    font-weight: normal;
    line-height: 1;
    z-index: 2;
    transform: skewX(-6deg);
    display: inline-block;
  }

  /* Fila inferior: LOS ANGELES */
  .logo-bottom-row {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .logo-main-title {
    font-family: var(--font-title);
    color: var(--color-red);
    font-size: 3.6rem;
    line-height: 0.95;
    letter-spacing: 0.05em;
    -webkit-text-stroke: 1.5px var(--color-black);
    text-shadow: 3px 3px 0px var(--color-black);
  }

  /* Lema o Eslogan */
  .tagline {
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-black);
    margin: 10px 0 20px 0;
    font-style: italic;
    text-align: center;
  }

  /* --- BARRA DE CABECERA MÓVIL --- */
  .mobile-header-bar {
    display: none;
    width: 100%;
    height: 95px;
    background-color: var(--color-bg);
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    z-index: 200;
  }

  /* Botón hamburguesa izquierdo */
  .menu-toggle-btn {
    width: 44px;
    height: 44px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 0;
    position: relative;
  }

  .hamburger-line {
    width: 26px;
    height: 3px;
    background-color: var(--color-black);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Animación del hamburguesa a X */
  .menu-toggle-btn.active .line-1 {
    transform: translateY(9px) rotate(45deg);
  }

  .menu-toggle-btn.active .line-2 {
    opacity: 0;
  }

  .menu-toggle-btn.active .line-3 {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Logotipo centrado en móvil */
  .mobile-logo-link {
    color: inherit;
    display: block;
    flex-grow: 1;
    text-align: center;
  }

  /* Botón llamar derecho */
  .mobile-call-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-red);
    background-color: transparent;
    border: none;
    cursor: pointer;
  }

  .phone-svg {
    width: 24px;
    height: 24px;
  }

  /* Adaptación extra del logotipo para móviles pequeños */
  @media (max-width: 400px) {
    .mobile-header-bar .banner-divided {
      height: 36px;
      padding: 0 20px;
    }
    .mobile-header-bar .banner-text {
      font-size: 1.4rem;
    }
    .mobile-header-bar .logo-main-title {
      font-size: 2rem;
      -webkit-text-stroke: 1px var(--color-black);
      text-shadow: 1.5px 1.5px 0px var(--color-black);
    }
  }

  /* --- MENÚ DESPLEGABLE MÓVIL (DESDE LA IZQUIERDA) --- */
  .mobile-nav-menu {
    position: fixed;
    top: 107px; /* 95px header + 12px faja industrial */
    left: 0;
    width: 280px;
    height: calc(100vh - 107px);
    background-color: var(--color-black);
    border-right: var(--border-width) solid var(--color-red);
    transform: translateX(-105%);
    transition: transform 0.2s ease-in-out;
    z-index: 1000;
    overflow-y: auto;
  }

  .mobile-nav-menu.active {
    transform: translateX(0);
  }

  .mobile-nav-menu ul {
    list-style: none;
    padding: 20px 0;
  }

  .mobile-nav-menu li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-nav-menu li:last-child {
    border-bottom: none;
  }

  .mobile-nav-item {
    display: block;
    padding: 14px 24px;
    font-family: var(--font-title);
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: var(--color-bg);
  }

  .mobile-nav-item:hover, .mobile-nav-item:focus {
    background-color: var(--color-red);
    color: #FFFFFF;
  }

  /* --- MENU DE NAVEGACION INDUSTRIAL ESCRITORIO --- */
  .industrial-nav {
    display: inline-block;
    width: 100%;
    margin-top: 10px;
  }

  .industrial-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    border: var(--border-width) solid var(--color-black);
    background-color: var(--color-bg);
  }

  .industrial-nav li {
    border-right: var(--border-width) solid var(--color-black);
  }

  .industrial-nav li:last-child {
    border-right: none;
  }

  .nav-item {
    display: block;
    padding: 10px 24px;
    font-family: var(--font-title);
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    color: var(--color-black);
    background-color: transparent;
    transition: background-color 0.1s steps(2), color 0.1s steps(2);
  }

  .nav-item:hover {
    background-color: var(--color-black);
    color: var(--color-yellow);
  }

  /* --- RESPONSIVE CONTROLS (MOBILE VS DESKTOP) --- */
  @media (max-width: 768px) {
    .main-header {
      padding: 0;
      border-bottom: none;
    }
    .mobile-header-bar {
      display: flex;
    }
    .desktop-header-only {
      display: none;
    }
    .desktop-nav-only {
      display: none;
    }
    .main-content {
      padding: 10px 0 40px 0;
    }
  }

  @media (min-width: 769px) {
    .mobile-header-bar {
      display: none;
    }
    .desktop-header-only {
      display: block;
    }
    .desktop-nav-only {
      display: block;
    }
    .mobile-nav-menu {
      display: none;
    }
  }

  /* --- CONTENIDO PRINCIPAL --- */
  .main-content {
    flex-grow: 1;
    padding: 40px 0;
  }

  /* --- FOOTER PESADO E INDUSTRIAL --- */
  .main-footer {
    background-color: var(--color-black);
    color: var(--color-bg);
    border-top: var(--border-width) solid var(--color-red);
    padding: 55px 0 35px 0;
    margin-top: auto;
    width: 100%;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 45px;
    border-bottom: 2px solid rgba(247, 244, 239, 0.15);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .footer-inner {
      padding: 0 20px;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    color: var(--color-yellow);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--color-red);
    padding-bottom: 5px;
    align-self: flex-start;
  }

  .contact-details p {
    margin-bottom: 12px;
  }

  .contact-details .label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
  }

  .phone-link {
    font-family: var(--font-title);
    font-size: 1.8rem;
    color: var(--color-red);
    letter-spacing: 0.02em;
    line-height: 1.2;
    display: inline-block;
  }

  .phone-link:hover {
    color: var(--color-yellow);
  }

  .email-link {
    color: var(--color-bg);
    text-decoration: underline;
    font-weight: 500;
  }

  .email-link:hover {
    color: var(--color-red);
  }

  .address-block {
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .since-block {
    font-weight: bold;
    color: var(--color-red);
    margin-bottom: 10px;
    margin-top: 15px;
  }

  .legal-links-list {
    list-style: none;
    margin-bottom: 15px;
  }

  .legal-links-list li {
    margin-bottom: 8px;
  }

  .legal-links-list a {
    color: #CCCCCC;
    text-decoration: underline;
    font-size: 0.95rem;
  }

  .legal-links-list a:hover {
    color: var(--color-yellow);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding-top: 25px;
    font-size: 0.85rem;
    color: #888888;
    gap: 15px;
  }

  .tag-engineering {
    font-family: var(--font-title);
    color: var(--color-bg);
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Estilos de Botones / Componentes comunes de utilidad industrial */
  .btn-industrial {
    display: inline-block;
